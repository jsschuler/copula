build/

# Python packaging/build artifacts (python/hdcd/, Milestone 10)
python/build/
python/hdcd.egg-info/
python/hdcd/libhdcd.dylib
python/hdcd/libhdcd.so
__pycache__/
*.pyc

# R packaging/build artifacts (r/, Milestone 11)
r/src/*.o
r/src/*.so
r/src/*.dylib
r/src/*.rds
r/src/symbols.rds
*.Rcheck/

# Julia environment resolution artifact (julia/, Milestone 12) -- the
# only dependency is the Libdl stdlib, so this pins little beyond "which
# Julia version generated it"; not worth committing.
julia/Manifest.toml

# Rendered notebook output (notebooks/, post-M12 validation) -- knitted
# from the .Rmd source on demand; not worth committing.
notebooks/*.html
notebooks/*_files/
notebooks/*_cache/
notebooks/*.log

